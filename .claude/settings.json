{
  "extraKnownMarketplaces": {
    "claude-mods": {
      "source": {
        "source": "github",
        "repo": "Faabyy/claude-mods"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "JohnnyVizz/claude-kit"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    },
    "catch-me-up": {
      "source": {
        "source": "github",
        "repo": "oliverow/catch-me-up"
      }
    }
  },
  "enabledPlugins": {
    "cache-tax@claude-mods": true,
    "savvy-flow@claude-kit": true,
    "savvy-progress@claude-kit": true,
    "filetree@claude-code-filetree": true,
    "catch-me-up@catch-me-up": true,
    "next-steps-cards@claude-mods": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ensure-mods.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'for p in \"${CLAUDE_MODS_DIR:-/nonexistent}/statusbar/bar.py\" \"$CLAUDE_PROJECT_DIR/.claude/statusbar/bar.py\"; do [ -f \"$p\" ] && exec python3 \"$p\"; done'",
    "padding": 0,
    "refreshInterval": 5
  }
}
